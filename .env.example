# Remote Patient Monitoring with Edge AI Configuration

# Backend API & Database Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./rpm_edge.db
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & JWT Authentication
JWT_SECRET_KEY=rpm_edge_ai_super_secret_jwt_key_2026_dev_only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Edge AI Configuration
EDGE_NODE_ID=EDGE-NODE-01
EDGE_SAMPLING_RATE_HZ=100
EDGE_INFERENCE_INTERVAL_SEC=1.0
BACKEND_WEBSOCKET_URL=ws://127.0.0.1:8000/ws/telemetry
BACKEND_REST_URL=http://127.0.0.1:8000/api

# Frontend Configuration
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_WS_URL=ws://127.0.0.1:8000/ws/telemetry
